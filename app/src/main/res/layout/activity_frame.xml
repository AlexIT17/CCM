<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_circle"
            android:contentDescription="Назад"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_circle"
            android:contentDescription="Вперёд"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_forward"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <View android:id="@+id/bandLeft"
            android:layout_width="48dp" android:layout_height="match_parent"
            android:background="@color/gray_light"/>
        <View android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@color/black"/>

        <FrameLayout android:id="@+id/content"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@color/white"/>

        <View android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@color/black"/>
        <View android:id="@+id/bandRight"
            android:layout_width="48dp" android:layout_height="match_parent"
            android:background="@color/gray_light"/>
    </LinearLayout>
</LinearLayout>